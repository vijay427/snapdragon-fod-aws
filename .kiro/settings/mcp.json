{
  "mcpServers": {
    "aws-docs": {
      "command": "uvx",
      "args": [
        "awslabs.aws-documentation-mcp-server@latest"
      ],
      "env": {
        "FASTMCP_LOG_LEVEL": "ERROR"
      },
      "disabled": true,
      "autoApprove": [
        "search_aws_documentation",
        "get_aws_service_info"
      ]
    },
    "snapdragon-simulator": {
      "command": "node",
      "args": [
        "./mcp-servers/snapdragon-simulator/dist/index.js"
      ],
      "disabled": false,
      "autoApprove": [
        "get_vehicle_state",
        "activate_feature",
        "deactivate_feature",
        "advance_time",
        "get_activation_logs",
        "reset_vehicle"
      ]
    },
    "github": {
      "command": "node",
      "args": [
        "./mcp-servers/github-custom/dist/index.js"
      ],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "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"
      },
      "disabled": false,
      "autoApprove": [
        "list_repositories",
        "create_repository",
        "list_issues",
        "create_issue",
        "update_issue",
        "create_pull_request",
        "get_user_info"
      ]
    },
    "filesystem": {
      "command": "node",
      "args": [
        "./mcp-servers/filesystem-custom/dist/index.js"
      ],
      "env": {
        "WORKSPACE_ROOT": "E:\\AWS-Kiro"
      },
      "disabled": false,
      "autoApprove": [
        "read_file",
        "write_file",
        "list_directory",
        "create_directory",
        "delete_file",
        "file_exists",
        "get_file_info"
      ]
    },
    "aws-operations": {
      "command": "node",
      "args": [
        "./mcp-servers/aws-operations/dist/index.js"
      ],
      "env": {
        "AWS_REGION": "us-east-1"
      },
      "disabled": false,
      "autoApprove": [
        "get_stack_status",
        "list_fod_stacks",
        "get_stack_outputs",
        "get_lambda_metrics",
        "list_lambda_functions",
        "get_deployment_events"
      ]
    }
  }
}