{
  "enabled": true,
  "name": "Test AWS Lambda Functions",
  "description": "When you modify AWS Lambda functions, automatically run unit tests",
  "version": "1",
  "when": {
    "type": "fileEdited",
    "patterns": [
      "src/lambda/**/*.ts",
      "src/lambda/**/*.js"
    ]
  },
  "then": {
    "type": "runCommand",
    "command": "npm test -- --testPathPattern=lambda"
  }
}