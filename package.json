{
  "name": "snapdragon-fod-aws",
  "version": "1.0.0",
  "description": "Snapdragon Feature on Demand system with AWS integration",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:property": "jest --testPathPattern=property",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "clean": "rm -rf dist",
    "db:setup": "ts-node src/shared/config/database-setup.ts",
    "db:test": "ts-node -e \"require('./src/shared/config/database').connectToDatabase().then(() => console.log('Connection successful')).catch(console.error)\"",
    "deploy": "node scripts/auto-deploy.js",
    "deploy:watch": "node scripts/watch-and-deploy.js",
    "hooks:setup": "node scripts/setup-git-hooks.js",
    "hooks:remove": "node scripts/setup-git-hooks.js --remove",
    "hooks:list": "node scripts/setup-git-hooks.js --list",
    "cicd:trigger": "node scripts/trigger-cicd.js",
    "lambda:list": "node scripts/check-lambda-status.js list",
    "lambda:health": "node scripts/check-lambda-status.js health",
    "lambda:details": "node scripts/check-lambda-status.js details",
    "lambda:test": "node scripts/check-lambda-status.js test",
    "lambda:logs": "node scripts/check-lambda-status.js logs",
    "lambda:api": "node scripts/check-lambda-status.js api",
    "lambda:urls": "node scripts/check-lambda-status.js urls",
    "lambda:all": "node scripts/check-lambda-status.js all"
  },
  "keywords": [
    "snapdragon",
    "fod",
    "aws",
    "iot",
    "vehicle"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-iot-data-plane": "^3.0.0",
    "@aws-sdk/client-secrets-manager": "^3.0.0",
    "axios": "^1.6.0",
    "mongodb": "^6.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "fast-check": "^3.0.0",
    "jest": "^29.0.0",
    "prettier": "^3.0.0",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.0.0",
    "typescript": "^5.0.0"
  }
}
