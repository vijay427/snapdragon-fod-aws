{
 "Description": "Database configuration for FOD system",
 "Resources": {
  "MongoDBConnectionStringDAC4F82C": {
   "Type": "AWS::SecretsManager::Secret",
   "Properties": {
    "Description": "MongoDB Atlas connection string for FOD system",
    "GenerateSecretString": {
     "ExcludePunctuation": true,
     "GenerateStringKey": "password",
     "IncludeSpace": false,
     "PasswordLength": 32,
     "SecretStringTemplate": "{\"connectionString\":\"mongodb+srv://fod-user:REPLACE_WITH_PASSWORD@cluster.mongodb.net/fod-system?retryWrites=true&w=majority\",\"database\":\"fod-system\",\"username\":\"fod-user\"}"
    },
    "Name": "FOD-Database-dev/mongodb-connection",
    "Tags": [
     {
      "Key": "Environment",
      "Value": "dev"
     },
     {
      "Key": "ManagedBy",
      "Value": "CDK"
     },
     {
      "Key": "Project",
      "Value": "Snapdragon-FOD"
     }
    ]
   },
   "UpdateReplacePolicy": "Delete",
   "DeletionPolicy": "Delete",
   "Metadata": {
    "aws:cdk:path": "FOD-Database-dev/MongoDBConnectionString/Resource"
   }
  },
  "MessageSigningKeysE1B0AF42": {
   "Type": "AWS::SecretsManager::Secret",
   "Properties": {
    "Description": "ECDSA keys for message signing and verification",
    "GenerateSecretString": {
     "ExcludePunctuation": true,
     "GenerateStringKey": "privateKey",
     "IncludeSpace": false,
     "SecretStringTemplate": "{\"algorithm\":\"ECDSA-SHA256\"}"
    },
    "Name": "FOD-Database-dev/signing-keys",
    "Tags": [
     {
      "Key": "Environment",
      "Value": "dev"
     },
     {
      "Key": "ManagedBy",
      "Value": "CDK"
     },
     {
      "Key": "Project",
      "Value": "Snapdragon-FOD"
     }
    ]
   },
   "UpdateReplacePolicy": "Delete",
   "DeletionPolicy": "Delete",
   "Metadata": {
    "aws:cdk:path": "FOD-Database-dev/MessageSigningKeys/Resource"
   }
  },
  "CDKMetadata": {
   "Type": "AWS::CDK::Metadata",
   "Properties": {
    "Analytics": "v2:deflate64:H4sIAAAAAAAA/yXHwQ2DMAxA0Vm4J25qRmAAJBigMsGtAiVUsUMOiN0R5fTfR8D6Ca6iItaPs/2GAfZeyc+GiryEfWKVhSJ9OMHe/98073jruNhm/WU9TFxHhkkeGyKgA1dNEoJNOWpYGLq7J4rC5i5xAAAA"
   },
   "Metadata": {
    "aws:cdk:path": "FOD-Database-dev/CDKMetadata/Default"
   }
  }
 },
 "Outputs": {
  "MongoDBSecretArn": {
   "Description": "MongoDB connection secret ARN",
   "Value": {
    "Ref": "MongoDBConnectionStringDAC4F82C"
   },
   "Export": {
    "Name": "FOD-Database-dev-MongoDBSecretArn"
   }
  },
  "SigningKeySecretArn": {
   "Description": "Message signing key secret ARN",
   "Value": {
    "Ref": "MessageSigningKeysE1B0AF42"
   },
   "Export": {
    "Name": "FOD-Database-dev-SigningKeySecretArn"
   }
  }
 },
 "Parameters": {
  "BootstrapVersion": {
   "Type": "AWS::SSM::Parameter::Value<String>",
   "Default": "/cdk-bootstrap/hnb659fds/version",
   "Description": "Version of the CDK Bootstrap resources in this environment, automatically retrieved from SSM Parameter Store. [cdk:skip]"
  }
 },
 "Rules": {
  "CheckBootstrapVersion": {
   "Assertions": [
    {
     "Assert": {
      "Fn::Not": [
       {
        "Fn::Contains": [
         [
          "1",
          "2",
          "3",
          "4",
          "5"
         ],
         {
          "Ref": "BootstrapVersion"
         }
        ]
       }
      ]
     },
     "AssertDescription": "CDK bootstrap stack version 6 required. Please run 'cdk bootstrap' with a recent version of the CDK CLI."
    }
   ]
  }
 }
}