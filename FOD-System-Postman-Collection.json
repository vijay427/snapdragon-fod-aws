                  "});",
                  "",
                  "pm.test(\"Purchase successful\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.success).to.eql(true);",
                  "    pm.expect(jsonData.data.transactionId).to.exist;",
                  "    pm.expect(jsonData.data.subscriptionId).to.exist;",
                  "    ",
                  "    // Save for next requests",
                  "    pm.collectionVariables.set(\"subscriptionId\", jsonData.data.subscriptionId);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
