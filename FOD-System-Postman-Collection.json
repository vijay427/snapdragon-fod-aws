{
  "info": {
    "name": "FOD System - Feature on Demand API",
    "description": "Complete API collection for Snapdragon Digital Chassis Feature on Demand system",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://zmko5jd2g5.execute-api.us-east-1.amazonaws.com/v1",
      "type": "string"
    },
    {
      "key": "vehicleId",
      "value": "VIN1234567890",
      "type": "string"
    },
    {
      "key": "featureId",
      "value": "SPORT_MODE",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Purchase Feature",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"featureId\": \"{{featureId}}\",\n  \"paymentMethod\": \"credit_card\",\n  \"paymentToken\": \"tok_visa_4242\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/features/purchase",
          "host": ["{{baseUrl}}"],
          "path": ["features", "purchase"]
        },
        "description": "Purchase a feature for a vehicle. Creates a transaction and subscription."
      },
      "response": []
    },
    {
      "name": "2. Activate Feature",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"vehicleId\": \"{{vehicleId}}\",\n  \"featureId\": \"{{featureId}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/features/activate",
          "host": ["{{baseUrl}}"],
          "path": ["features", "activate"]
        },
        "description": "Activate a purchased feature on the vehicle via IoT Core."
      },
      "response": []
    },
    {
      "name": "3. Deactivate Feature",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/vehicles/{{vehicleId}}/features/{{featureId}}",
          "host": ["{{baseUrl}}"],
          "path": ["vehicles", "{{vehicleId}}", "features", "{{featureId}}"]
        },
        "description": "Deactivate an active feature on the vehicle."
      },
      "response": []
    },
    {
      "name": "4. Get Vehicle Features",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/vehicles/{{vehicleId}}/features",
          "host": ["{{baseUrl}}"],
          "path": ["vehicles", "{{vehicleId}}", "features"]
        },
        "description": "Get all active features for a specific vehicle."
      },
      "response": []
    },
    {
      "name": "5. Get Feature Catalog",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/features/catalog",
          "host": ["{{baseUrl}}"],
          "path": ["features", "catalog"]
        },
        "description": "Get all available features in the system catalog."
      },
      "response": []
    },
